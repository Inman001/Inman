--// ==========================================
--// [CORE UPDATE] ระบบ ESP Only
--// ==========================================
local HighlightCache = {}
local HealthBarCache = {}

local function ManageESP()
    -- 1. อัปเดตจุดเล็ง
    if ESP_Dot then
        CenterDot.Visible = true
        CenterDot.Size = UDim2.fromOffset(Dot_Size, Dot_Size)
        CenterDot.Position = UDim2.fromOffset((Camera.ViewportSize.X / 2) + Dot_OffsetX, (Camera.ViewportSize.Y / 2) + Dot_OffsetY)
    else
        CenterDot.Visible = false
    end

    -- 2. ยิง Raycast ตรวจหาผู้เล่นเพื่อทำ Highlight
    local hoveredCharacter = nil
    if ESP_Highlight and ESP_Dot then
        local dotX = (Camera.ViewportSize.X / 2) + Dot_OffsetX
        local dotY = (Camera.ViewportSize.Y / 2) + Dot_OffsetY
        local ray = Camera:ViewportPointToRay(dotX, dotY)
        
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LocalPlayer.Character, ScreenGui}
        params.FilterType = Enum.RaycastFilterType.Exclude

        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if result and result.Instance then
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
                hoveredCharacter = model
            end
        end
    end

    -- 3. อัปเดตระบบสแกนผู้เล่น
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") and char.Humanoid.Health > 0 then
                
                -- ====== จัดการ ESP เส้นกรอบ / สีทีม ======
                local isHovered = (char == hoveredCharacter)
                if ESP_Normal or (isHovered and ESP_Highlight) then
                    local hl = HighlightCache[char]
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Parent = ScreenGui
                        HighlightCache[char] = hl
                    end
                    hl.Adornee = char
                    
                    if isHovered then
                        hl.FillColor = Color3.fromRGB(90, 0, 140)
                        hl.OutlineColor = Color3.fromRGB(180, 50, 255)
                        hl.FillTransparency = 0.35
                        hl.OutlineTransparency = 0
                    else
                        local teamColor = p.Team and p.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                        hl.FillColor = teamColor
                        hl.OutlineColor = teamColor
                        hl.FillTransparency = 0.6
                        hl.OutlineTransparency = 0.2
                    end
                else
                    if HighlightCache[char] then
                        HighlightCache[char]:Destroy()
                        HighlightCache[char] = nil
                    end
                end

                -- ====== จัดการ ESP หลอดเลือด HP (อัปเกรดดีไซน์) ======
                if ESP_Health then
                    local hb = HealthBarCache[char]
                    if not hb then
                        hb = Instance.new("BillboardGui")
                        hb.Name = "PlayerHealthBar_Modern"
                        hb.AlwaysOnTop = true
                        
                        -- [แก้บัคหลอดอ้วน]: ใช้ Scale (Studs) แทน Offset (พิกเซล) 
                        -- กว้าง 0.35 Studs, สูง 5.2 Studs ทำให้เล็กลงตามระยะทางเป๊ะๆ
                        hb.Size = UDim2.new(0.35, 0, 5.2, 0)
                        hb.StudsOffset = Vector3.new(2.5, 0, 0) 
                        hb.Adornee = char:FindFirstChild("HumanoidRootPart")
                        hb.Parent = ScreenGui

                        -- พื้นหลังหลอดเลือด
                        local bgFrame = Instance.new("Frame", hb)
                        bgFrame.Name = "Background"
                        bgFrame.Size = UDim2.new(1, 0, 1, 0)
                        bgFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                        bgFrame.BackgroundTransparency = 0.5
                        bgFrame.BorderSizePixel = 0
                        
                        -- [Modern UI]: ทำขอบโค้งมนแบบแคปซูล
                        local bgCorner = Instance.new("UICorner", bgFrame)
                        bgCorner.CornerRadius = UDim.new(1, 0)
                        
                        -- [Modern UI]: ใส่เส้นขอบสีดำให้หลอดดูมีมิติ
                        local bgStroke = Instance.new("UIStroke", bgFrame)
                        bgStroke.Thickness = 1.2
                        bgStroke.Color = Color3.fromRGB(0, 0, 0)
                        bgStroke.Transparency = 0.2

                        -- หลอดเลือดด้านใน (ตัวที่วิ่งขึ้นลง)
                        local fillFrame = Instance.new("Frame", bgFrame)
                        fillFrame.Name = "Fill"
                        fillFrame.AnchorPoint = Vector2.new(0, 1) 
                        fillFrame.Position = UDim2.new(0, 0, 1, 0)
                        fillFrame.BorderSizePixel = 0
                        
                        -- [Modern UI]: ขอบโค้งมนของหลอดด้านใน
                        local fillCorner = Instance.new("UICorner", fillFrame)
                        fillCorner.CornerRadius = UDim.new(1, 0)
                        
                        HealthBarCache[char] = hb
                    end

                    local hum = char.Humanoid
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local fill = hb.Background.Fill
                    
                    fill.Size = UDim2.new(1, 0, pct, 0)

                    -- [Modern UI]: ปรับโทนสีให้เป็นแบบ Flat Design ดูสะอาดตาขึ้น
                    if pct > 0.7 then
                        fill.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- เขียวพาสเทล
                    elseif pct > 0.4 then
                        fill.BackgroundColor3 = Color3.fromRGB(241, 196, 15) -- เหลืองส้ม
                    elseif pct > 0.2 then
                        fill.BackgroundColor3 = Color3.fromRGB(230, 126, 34) -- ส้ม
                    else
                        fill.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- แดง
                    end
                else
                    if HealthBarCache[char] then
                        HealthBarCache[char]:Destroy()
                        HealthBarCache[char] = nil
                    end
                end

            else
                if HighlightCache[char] then HighlightCache[char]:Destroy(); HighlightCache[char] = nil end
                if HealthBarCache[char] then HealthBarCache[char]:Destroy(); HealthBarCache[char] = nil end
            end
        end
    end
    
    for char, hl in pairs(HighlightCache) do
        if not char or not char.Parent then if hl then hl:Destroy() end; HighlightCache[char] = nil end
    end
    for char, hb in pairs(HealthBarCache) do
        if not char or not char.Parent then if hb then hb:Destroy() end; HealthBarCache[char] = nil end
    end
end

