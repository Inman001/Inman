local function resetCameraToNormal()
    Camera.CameraType = Enum.CameraType.Custom
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if humanoid then Camera.CameraSubject = humanoid end
        if hrp then hrp.Anchored = false end
    end
end

local function toggleFreecam(state)
    freecamEnabled = state
    FreecamBtn.BackgroundColor3 = freecamEnabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    FreecamBtn.Text = freecamEnabled and "FreeCam\n[ON]" or "FreeCam\n[OFF]"

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    if freecamEnabled then
        if freezeCamEnabled then
            freezeCamEnabled = false
            FreezeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            FreezeBtn.Text = "Freeze\n[OFF]"
        end

        camCFrame = Camera.CFrame
        local x, y, _ = camCFrame:ToOrientation()
        rotX, rotY = x, y

        Camera.CameraType = Enum.CameraType.Scriptable
        if hrp then hrp.Anchored = true end
    else
        resetCameraToNormal()
    end
    
    cameraTouchObject = nil
    isDraggingMouse = false
end

local function toggleFreezeCam(state)
    freezeCamEnabled = state
    FreezeBtn.BackgroundColor3 = freezeCamEnabled and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(200, 50, 50)
    FreezeBtn.Text = freezeCamEnabled and "Freeze\n[ON]" or "Freeze\n[OFF]"

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    if freezeCamEnabled then
        if freecamEnabled then
            freecamEnabled = false
            FreecamBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            FreecamBtn.Text = "FreeCam\n[OFF]"
        end

        freezeCFrame = Camera.CFrame
        Camera.CameraType = Enum.CameraType.Scriptable
        if hrp then hrp.Anchored = false end
    else
        resetCameraToNormal()
    end

    cameraTouchObject = nil
    isDraggingMouse = false
end

FreecamBtn.MouseButton1Click:Connect(function()
    toggleFreecam(not freecamEnabled)
end)

FreezeBtn.MouseButton1Click:Connect(function()
    toggleFreezeCam(not freezeCamEnabled)
end)

--// ==========================================
--// [6] ระบบ INPUT
--// ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not freecamEnabled then return end

    if input.UserInputType == Enum.UserInputType.Touch then
        if input.Position.X > Camera.ViewportSize.X * 0.25 then
            cameraTouchObject = input
            lastTouchPos = Vector2.new(input.Position.X, input.Position.Y)
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        isDraggingMouse = true
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        local code = input.KeyCode
        if code == Enum.KeyCode.W then keysPressed.W = -1 end
        if code == Enum.KeyCode.S then keysPressed.S = 1 end
        if code == Enum.KeyCode.A then keysPressed.A = -1 end
        if code == Enum.KeyCode.D then keysPressed.D = 1 end
        if code == Enum.KeyCode.E then keysPressed.E = 1 end
        if code == Enum.KeyCode.Q then keysPressed.Q = -1 end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == cameraTouchObject then cameraTouchObject = nil end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then isDraggingMouse = false end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        local code = input.KeyCode
        if code == Enum.KeyCode.W then keysPressed.W = 0 end
        if code == Enum.KeyCode.S then keysPressed.S = 0 end
        if code == Enum.KeyCode.A then keysPressed.A = 0 end
        if code == Enum.KeyCode.D then keysPressed.D = 0 end
        if code == Enum.KeyCode.E then keysPressed.E = 0 end
        if code == Enum.KeyCode.Q then keysPressed.Q = 0 end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not freecamEnabled then return end

    local sensitivity = (camTurnSpeed / 20000)

    if input.UserInputType == Enum.UserInputType.Touch and input == cameraTouchObject then
        local currentPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = currentPos - lastTouchPos
        lastTouchPos = currentPos

        rotY = rotY - (delta.X * sensitivity)
        rotX = math.clamp(rotX - (delta.Y * sensitivity), -math.rad(89), math.rad(89))

    elseif input.UserInputType == Enum.UserInputType.MouseMovement and isDraggingMouse then
        local delta = input.Delta
        rotY = rotY - (delta.X * sensitivity)
        rotX = math.clamp(rotX - (delta.Y * sensitivity), -math.rad(89), math.rad(89))
    end
end)

--// ==========================================
--// [7] RENDER LOOP
--// ==========================================
RunService.RenderStepped:Connect(function(dt)
    if freecamEnabled then
        local rotCFrame = CFrame.Angles(0, rotY, 0) * CFrame.Angles(rotX, 0, 0)
        local moveVector = Vector3.zero

        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.MoveDirection.Magnitude > 0 then
            local flatLook = Vector3.new(rotCFrame.LookVector.X, 0, rotCFrame.LookVector.Z).Unit
            local flatRight = Vector3.new(rotCFrame.RightVector.X, 0, rotCFrame.RightVector.Z).Unit
            local fwdInput = humanoid.MoveDirection:Dot(flatLook)
            local rightInput = humanoid.MoveDirection:Dot(flatRight)
            moveVector = (rotCFrame.LookVector * fwdInput) + (rotCFrame.RightVector * rightInput)
        else
            local kbX = keysPressed.A + keysPressed.D
            local kbZ = keysPressed.W + keysPressed.S
            if kbX ~= 0 or kbZ ~= 0 then
                local kbDir = Vector3.new(kbX, 0, kbZ).Unit
                moveVector = rotCFrame:VectorToWorldSpace(kbDir)
            end
        end

        local upDown = keysPressed.E + keysPressed.Q
        local verticalMove = Vector3.new(0, upDown, 0)

        local deltaPos = (moveVector + verticalMove) * (camMoveSpeed * 15 * dt)
        camCFrame = CFrame.new(camCFrame.Position + deltaPos) * rotCFrame
        Camera.CFrame = camCFrame

    elseif freezeCamEnabled then
        Camera.CFrame = freezeCFrame
    end
end)

--// ==========================================
--// [8] ระบบลากย้ายหน้าต่าง UI และ ปุ่ม 📷 (แยกจากกันอิสระ)
--// ==========================================
-- 8.1 ระบบลากย้าย MainFrame
local function makeMainFrameDraggable(obj)
    local dragging, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = obj.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- 8.2 ระบบแยก "ลาก" และ "คลิก" ของปุ่ม 📷
local function setupIconBtnDragAndClick(btn)
    local dragging = false
    local hasMoved = false
    local dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                hasMoved = true -- หากเลื่อนเกิน 6 พิกเซลจะถือว่าเป็นการ "ลากย้าย" ไม่ใช่การแตะเปิด
            end
            if hasMoved then
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                -- ถ้าไม่ได้ลากย้าย ให้ถือเป็นการ "คลิก/แตะ" เพื่อเปิด UI ตรงตำแหน่งปัจจุบันของ 📷
                if not hasMoved then
                    MainFrame.Position = btn.Position
                    btn.Visible = false
                    MainFrame.Visible = true
                end
            end
        end
    end)
end

makeMainFrameDraggable(MainFrame)
setupIconBtnDragAndClick(ToggleIconBtn)
