--// ตรวจสอบทะลุกำแพง
local function isPartVisible(targetPart, targetCharacter)
    if WallbangEnabled then return true end
    if not targetPart then return false end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter}
    params.IgnoreWater = true

    local currentOrigin = origin
    local remainingDir = direction

    for i = 1, 5 do
        local result = workspace:Raycast(currentOrigin, remainingDir, params)
        if not result then return true end

        local hitPart = result.Instance
        if hitPart.Transparency >= 0.5 or not hitPart.CanCollide then
            currentOrigin = result.Position + (remainingDir.Unit * 0.1)
            remainingDir = targetPart.Position - currentOrigin
            table.insert(params.FilterDescendantsInstances, hitPart)
            params.FilterDescendantsInstances = params.FilterDescendantsInstances
        else
            return false
        end
    end
    return false
end

local function isSameTeam(targetCharacter)
    if not TeamCheckEnabled then return false end
    local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
    if targetPlayer and targetPlayer.Team == LocalPlayer.Team then return true end
    return false
end

--// หาตำแหน่งล็อกเป้า
local function getAimPoint(character)
    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")

    if TargetMode == 1 then
        if head and isPartVisible(head, character) then return head.Position end
    elseif TargetMode == 2 then
        if torso and isPartVisible(torso, character) then return torso.Position end
    elseif TargetMode == 3 then
        if torso and isPartVisible(torso, character) then return torso.Position end
        if head and isPartVisible(head, character) then return head.Position end
    end
    return nil
end

local function isValidCharacter(character)
    if not character or not character.Parent then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not root or humanoid.Health <= 0 then return false end
    if isSameTeam(character) then return false end
    if not getAimPoint(character) then return false end
    
    return true
end

local function getScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function getClosestTarget()
    local closestCharacter = nil
    local closestDistance = FOVRadius
    local center = getScreenCenter()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isValidCharacter(player.Character) then
            local aimPoint = getAimPoint(player.Character)
            if aimPoint then
                local screenPosition, onScreen = Camera:WorldToViewportPoint(aimPoint)
                if onScreen then
                    local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestCharacter = player.Character
                    end
                end
            end
        end
    end

    return closestCharacter
end

local function parseSmoothValue(V)
    local alpha = 0.15
    local predFactor = 0
    
    if V <= 25 then
        alpha = 0.005 + (V / 25) * 0.035
    elseif V <= 50 then
        alpha = 0.04 + ((V - 25) / 25) * 0.11
    elseif V <= 100 then
        alpha = 0.15 + ((V - 50) / 50) * 0.85
    elseif V <= 125 then
        alpha = 0.14
        predFactor = (V - 100) / 25
    else
        alpha = 0.14
        predFactor = 1 + ((V - 125) / 25)
    end
    
    return alpha, predFactor
end

-- ฟังก์ชันหาค่ามุมที่สั้นที่สุดเพื่อป้องกันเป้าหมุนมั่ว
local function getShortestAngle(current, target)
    return (target - current + math.pi) % (math.pi * 2) - math.pi
end

--// Main Loop (แก้ใช้ BindToRenderStep ระดับความสำคัญสูงกว่า Camera)
RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function()
    if not ScreenGui or not ScreenGui.Parent then
        RunService:UnbindFromRenderStep(RENDER_NAME)
        return
    end

    Camera = workspace.CurrentCamera
    local center = getScreenCenter()
    FOVCircle.Position = UDim2.fromOffset(center.X, center.Y)

    if not AimNormalEnabled and not AimSmoothEnabled then return end

    if LockedTarget then
        local humanoid = LockedTarget:FindFirstChildOfClass("Humanoid")
        if not LockedTarget.Parent or (humanoid and humanoid.Health <= 0) then
            LockedTarget = nil
            LockButton.Text = "Lock: NONE"
        end
    end

    if LockedTarget then
        local aimPoint = getAimPoint(LockedTarget)
        if aimPoint then
            local screenPosition, onScreen = Camera:WorldToViewportPoint(aimPoint)
            if onScreen then
                local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude
                if distance > FOVRadius then
                    LockedTarget = nil
                    LockButton.Text = "Lock: NONE"
                end
            else
                LockedTarget = nil
                LockButton.Text = "Lock: NONE"
            end
        else
            LockedTarget = nil
            LockButton.Text = "Lock: NONE"
        end
    end

    if not LockedTarget then
        LockedTarget = getClosestTarget()
        if LockedTarget then
            LockButton.Text = "Lock: " .. LockedTarget.Name
        else
            LockButton.Text = "Lock: NONE"
        end
    end

    if LockedTarget then
        local aimPoint = getAimPoint(LockedTarget)
        if aimPoint then
            local currentCFrame = Camera.CFrame
            local targetCharacter = LockedTarget
            local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
            
            -- อัปเดตเช็คความเร็วเป้าหมายให้รองรับแมพใหม่ๆ แม่นยำขึ้น
            local targetVelocity = rootPart and (rootPart.AssemblyLinearVelocity or rootPart.Velocity) or Vector3.new(0, 0, 0)
            
            local alphaX, predX = parseSmoothValue(HorizontalSmooth)
            local alphaY, predY = parseSmoothValue(VerticalSmooth)
            
            if AimNormalEnabled then
                alphaX = 1
                alphaY = 1
                predX = 0
                predY = 0
            end
            
            local finalAimPosition = Vector3.new(
                aimPoint.X + (targetVelocity.X * predX * 0.22),
                aimPoint.Y + (targetVelocity.Y * predY * 0.22),
                aimPoint.Z + (targetVelocity.Z * predX * 0.22)
            )
            
            -- [FIX 3rd Person] ใช้ CFrame.lookAt และแยกคำนวณแกน X Y Z ระดับพิกเซล
            local targetLookCFrame = CFrame.lookAt(currentCFrame.Position, finalAimPosition)
            
            local currentX, currentY, currentZ = currentCFrame:ToEulerAnglesYXZ()
            local targetX, targetY, targetZ = targetLookCFrame:ToEulerAnglesYXZ()
            
            local nextX = currentX + getShortestAngle(currentX, targetX) * alphaY
            local nextY = currentY + getShortestAngle(currentY, targetY) * alphaX
            
            Camera.CFrame = CFrame.new(currentCFrame.Position) * CFrame.fromEulerAnglesYXZ(nextX, nextY, 0)
        end
    end
end)
