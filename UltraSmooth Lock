local function createSlider(title, yPos, defaultValue, callback)
    local SliderFrame = Instance.new("Frame", Window)
    SliderFrame.Size = UDim2.new(1, -16, 0, 38)
    SliderFrame.Position = UDim2.fromOffset(8, yPos)
    SliderFrame.BackgroundTransparency = 1

    local LabelBox = Instance.new("TextBox", SliderFrame)
    LabelBox.Size = UDim2.new(1, 0, 0, 16)
    LabelBox.BackgroundTransparency = 1
    LabelBox.Font = Enum.Font.SourceSansBold
    LabelBox.TextSize = 11
    LabelBox.TextColor3 = Color3.new(1, 1, 1)
    LabelBox.TextXAlignment = Enum.TextXAlignment.Left
    LabelBox.ClearTextOnFocus = false

    local Track = Instance.new("Frame", SliderFrame)
    Track.Size = UDim2.new(1, 0, 0, 6)
    Track.Position = UDim2.fromOffset(0, 20)
    Track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local Fill = Instance.new("Frame", Track)
    Fill.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("TextButton", Track)
    Knob.Size = UDim2.fromOffset(12, 12)
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    Knob.Text = ""
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local KnobStroke = Instance.new("UIStroke", Knob)
    KnobStroke.Color = Color3.new(0,0,0)

    local currentVal = defaultValue

    local function updateSliderVisuals(value)
        local scale = math.clamp(value / 150, 0, 1)
        Knob.Position = UDim2.new(scale, 0, 0.5, 0)
        Fill.Size = UDim2.new(scale, 0, 1, 0)
        
        local status = ""
        if value <= 25 then status = " [หน่วง]"
        elseif value <= 50 then status = " [ดีเลย์]"
        elseif value <= 100 then status = " [ปกติ]"
        elseif value <= 125 then status = " [ล่วงหน้า]"
        else status = " [ล่วงหน้าx2]" end
        
        LabelBox.Text = title .. ": " .. tostring(value) .. status
        callback(value)
    end

    local function updateSliderFromPos(inputPosition)
        local scale = math.clamp((inputPosition.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        currentVal = math.round(scale * 150)
        updateSliderVisuals(currentVal)
    end

    local draggingSlider = false
    Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true end
    end)
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then updateSliderFromPos(input.Position); draggingSlider = true end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSliderFromPos(input.Position) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end
    end)

    LabelBox.FocusLost:Connect(function(enterPressed)
        local text = LabelBox.Text:gsub("%D+", "")
        local num = tonumber(text)
        if num then
            currentVal = math.clamp(num, 0, 150)
        end
        updateSliderVisuals(currentVal)
    end)

    updateSliderVisuals(defaultValue)
end

