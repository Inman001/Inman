--// ==========================================
--// [9] RENDER LOOP
--// ==========================================
RunService.RenderStepped:Connect(function()
    if not isRadarUI_On or not isRadarSystem_On then return end

    local now = os.clock()
    if now - lastUpdate < UPDATE_RATE then return end
    lastUpdate = now

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local cam = Workspace.CurrentCamera
    local camLook = cam.CFrame.LookVector
    local flatDir = Vector3.new(camLook.X, 0, camLook.Z)
    if flatDir.Magnitude > 0.001 then
        flatDir = flatDir.Unit
    else
        flatDir = Vector3.new(myHRP.CFrame.LookVector.X, 0, myHRP.CFrame.LookVector.Z).Unit
    end

    local referenceCFrame = CFrame.lookAt(myHRP.Position, myHRP.Position + flatDir)
    local validPlayers = {}
    local closestDist  = math.huge
    local closestName  = ""
    local closestColor = Color3.fromRGB(255, 50, 50)

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        if friendCache[player.UserId] == nil then
            local ok, result = pcall(function()
                return LocalPlayer:IsFriendsWith(player.UserId)
            end)
            friendCache[player.UserId] = ok and result or false
        end
        local isFriend  = friendCache[player.UserId]
        local isSameTeam = (player.Team ~= nil and player.Team == LocalPlayer.Team)

        if friendOnly and not isFriend then continue end

        local targetChar = player.Character
        local targetHRP  = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum  = targetChar and targetChar:FindFirstChild("Humanoid")
        if not (targetHRP and targetHum and targetHum.Health > 0) then continue end

        local offset = referenceCFrame:ToObjectSpace(targetHRP.CFrame).Position
        local dist2D = Vector2.new(offset.X, offset.Z).Magnitude
        if dist2D > radarRadius then continue end

        validPlayers[player.Name] = true

        -- หาสีของผู้เล่นคนนี้
        local playerColor
        if isFriend then
            playerColor = Color3.fromRGB(128, 0, 128)
        elseif player.Team then
            playerColor = player.TeamColor.Color
        else
            playerColor = Color3.fromRGB(255, 50, 50)
        end

        -- เช็คคนใกล้สุดสำหรับแจ้งเตือน
        -- ถ้าเปิด alertEnemyOnly จะแจ้งเฉพาะต่างทีม
        local shouldAlert = not alertEnemyOnly or not isSameTeam
        if dist2D < closestDist and shouldAlert then
            closestDist  = dist2D
            closestName  = player.Name
            closestColor = playerColor
        end

        -- blip
        local blipData = blips[player.Name]
        if not blipData then
            local blip = Instance.new("Frame")
            blip.AnchorPoint = Vector2.new(0.5, 0.5)
            blip.ZIndex = 10
            Instance.new("UICorner", blip).CornerRadius = UDim.new(1, 0)
            blip.Parent = RadarScreen

            local infoLabel = Instance.new("TextLabel", blip)
            infoLabel.Size = UDim2.fromOffset(60, 28)
            infoLabel.AnchorPoint = Vector2.new(0.5, 1)
            infoLabel.Position = UDim2.new(0.5, 0, 0, -2)
            infoLabel.BackgroundTransparency = 1
            infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            infoLabel.TextStrokeTransparency = 0
            infoLabel.Font = Enum.Font.GothamBold
            infoLabel.TextSize = 8
            infoLabel.Text = ""
            infoLabel.ZIndex = 11

            local altLabel = Instance.new("TextLabel", blip)
            altLabel.Size = UDim2.fromOffset(15, 12)
            altLabel.AnchorPoint = Vector2.new(0.5, 0.5)
            altLabel.Position = UDim2.new(0.5, 0, 0.5, 8)
            altLabel.BackgroundTransparency = 1
            altLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            altLabel.TextStrokeTransparency = 0
            altLabel.Font = Enum.Font.GothamBold
            altLabel.TextSize = 9
            altLabel.Text = ""
            altLabel.ZIndex = 11

            blipData = {frame = blip, info = infoLabel, alt = altLabel}
            blips[player.Name] = blipData
        end

        local blip      = blipData.frame
        local infoLabel = blipData.info
        local altLabel  = blipData.alt

        local scaleRatio = (radarRadius - 10) / (100000 - 10)
        local blipSize   = math.clamp(8 - (scaleRatio * 6), 2, 8)
        blip.Size = UDim2.fromOffset(blipSize, blipSize)
        blip.BackgroundColor3 = playerColor

        -- ลูกศรความสูง
        local heightDiff = targetHRP.Position.Y - myHRP.Position.Y
        if heightDiff > 10 then
            altLabel.Text = "^"
            altLabel.Position = UDim2.new(0.5, 0, 0.5, 8)
        elseif heightDiff < -10 then
            altLabel.Text = "v"
            altLabel.Position = UDim2.new(0.5, 0, 0.5, 8)
        else
            altLabel.Text = ""
        end

        -- ชื่อ + ระยะ
        local infoText = ""
        if showName then infoText = player.Name end
        if showDist then
            local distText = math.floor(dist2D) .. "m"
            infoText = infoText ~= "" and (infoText .. "\n" .. distText) or distText
        end
        infoLabel.Text = infoText

        local uiRadius = RadarScreen.AbsoluteSize.X / 2
        local scale    = uiRadius / radarRadius
        blip.Position  = UDim2.fromOffset(
            uiRadius + (offset.X * scale),
            uiRadius + (offset.Z * scale)
        )
    end

    -- ลบ blip เก่า
    for playerName, blipData in pairs(blips) do
        if not validPlayers[playerName] then
            blipData.frame:Destroy()
            blips[playerName] = nil
        end
    end

    -- ✅ แจ้งเตือน พร้อมเปลี่ยนสีตามทีมของคนนั้น
    if alertEnabled and closestDist <= alertRange then
        local nowClock = os.clock()
        if nowClock - alertCooldown > 3 then
            alertCooldown = nowClock
            AlertSound:Play()
            AlertLabel.BackgroundColor3 = closestColor
            AlertLabel.Text = "!! " .. closestName .. " เข้ามาใกล้ (" .. math.floor(closestDist) .. "m) !!"
            AlertLabel.Visible = true
            task.delay(2.5, function()
                AlertLabel.Visible = false
            end)
        end
    end
end)

